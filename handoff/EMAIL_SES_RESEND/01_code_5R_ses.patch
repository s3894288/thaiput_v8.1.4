+    payload: q.opts.payload, amzDate: h['X-Amz-Date'], region: 'ap-southeast-1', service: 'ses', secret: 'wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY' }), 'chữ ký khớp bản độc lập');
